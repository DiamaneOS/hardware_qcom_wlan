// Converted from the CodeLinaro Android.mk with NAN_VENDOR_AIDL and PASN off.

cc_library_shared {
    name: "libwifi-hal-ctrl",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    local_include_dirs: ["wifi_hal_ctrl"],
    srcs: ["wifi_hal_ctrl/wifi_hal_ctrl.c"],
    header_libs: ["libcutils_headers"],
}

cc_library_headers {
    name: "libwifi-hal-ctrl_headers",
    vendor: true,
    export_include_dirs: ["wifi_hal_ctrl"],
    header_libs: ["libcutils_headers"],
}

soong_config_module_type {
    name: "wifi_hal_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "wifi",
    bool_variables: [
        "target_uses_aosp_for_wlan", // TARGET_USES_AOSP_FOR_WLAN
    ],
    value_variables: [
        "driver_state_ctrl_param", // WIFI_DRIVER_STATE_CTRL_PARAM
        "driver_state_on", // WIFI_DRIVER_STATE_ON
    ],
    properties: ["cflags"],
}

wifi_hal_cc_defaults {
    name: "libwifi-hal-qcom-defaults",
    soong_config_variables: {
        driver_state_ctrl_param: {
            cflags: ["-DWIFI_DRIVER_STATE_CTRL_PARAM=%s"],
        },
        driver_state_on: {
            cflags: ["-DWIFI_DRIVER_STATE_ON=%s"],
        },
        target_uses_aosp_for_wlan: {
            conditions_default: {
                cflags: ["-DWCNSS_QTI_AOSP"],
            },
        },
    },
}

cc_library_static {
    name: "libwifi-hal-qcom",
    vendor: true,
    defaults: ["libwifi-hal-qcom-defaults"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        // gscan.cpp: address of array 'cached_results[i].results' will always evaluate to 'true'
        "-Wno-pointer-bool-conversion",
    ],
    product_variables: {
        debuggable: {
            cflags: ["-DLOG_NDEBUG=0"],
        },
    },
    local_include_dirs: [
        ".",
        "vendor_nan",
    ],
    // The CodeLinaro sources include the legacy HAL headers without their
    // hardware_legacy/ prefix, as the original Android.mk allowed.
    include_dirs: ["hardware/interfaces/wifi/legacy_headers/include/hardware_legacy"],
    header_libs: [
        "libcutils_headers",
        "libnetlink_iface_headers",
        "libutils_headers",
        "libwifi-hal-ctrl_headers",
        "wifi_legacy_headers",
        "//hardware/qcom/wlan/cld80211-lib:libcld80211_headers",
    ],
    srcs: [
        "common.cpp",
        "cpp_bindings.cpp",
        "gscan.cpp",
        "gscan_event_handler.cpp",
        "ifaceeventhandler.cpp",
        "list.cpp",
        "llstats.cpp",
        "nan.cpp",
        "nan_ind.cpp",
        "nan_pairing.cpp",
        "nan_pairing_initiator.cpp",
        "nan_pairing_responder.cpp",
        "nan_req.cpp",
        "nan_rsp.cpp",
        "radio_mode.cpp",
        "rb_wrapper.cpp",
        "ring_buffer.cpp",
        "roam.cpp",
        "rssi_monitor.cpp",
        "rtt.cpp",
        "tcp_params_update.cpp",
        "tdls.cpp",
        "wifi_hal.cpp",
        "wificonfig.cpp",
        "wifihal_vendor.cpp",
        "wifilogger.cpp",
        "wifilogger_diag.cpp",
    ],
    shared_libs: [
        "//hardware/qcom/wlan/cld80211-lib:libcld80211",
        "libcrypto",
        "libcutils",
        "liblog",
        "libnetutils",
        "libnl",
        "libwifi-hal-ctrl",
    ],
    sanitize: {
        cfi: true,
        integer_overflow: true,
    },
}
