// DiamaneOS: Soong build for the CodeLinaro Qualcomm Wi-Fi HAL. It replaces
// AOSP's hardware/qcom/wlan and keeps the libwifi-hal-qcom defaults name that
// frameworks/opt/net/wifi/libwifi_hal selects for BOARD_WLAN_DEVICE qcwcn.
// Build the vendor HAL, cld80211, and the optional supplicant command backend.
// Vendor NAN AIDL, NAN pairing (PASN), and wcnss-service remain unselected.

package {
    default_applicable_licenses: ["hardware_qcom_wlan_license"],
}

license {
    name: "hardware_qcom_wlan_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
    ],
}

cc_defaults {
    name: "libwifi-hal-qcom",
    whole_static_libs: ["//hardware/qcom/wlan/qcwcn:libwifi-hal-qcom"],
    shared_libs: [
        "//hardware/qcom/wlan/cld80211-lib:libcld80211",
        "libcrypto",
    ],
}


// Use the same feature defines and private nl80211 headers as the consuming
// AOSP supplicant. The board selects this library through its standard hook.
cc_library_static {
    name: "lib_driver_cmd_qcwcn",
    proprietary: true,
    defaults: ["wpa_supplicant_cflags_default"],
    srcs: [
        "qcwcn/wpa_supplicant_8_lib/driver_cmd_nl80211.c",
        "qcwcn/wpa_supplicant_8_lib/driver_cmd_nl80211_extn.c",
        "qcwcn/wpa_supplicant_8_lib/driver_cmd_nl80211_mlo.c",
        "qcwcn/wpa_supplicant_8_lib/driver_cmd_nl80211_sr.c",
    ],
    include_dirs: [
        "external/libnl/include",
        "external/wpa_supplicant_8/src",
        "external/wpa_supplicant_8/src/common",
        "external/wpa_supplicant_8/src/drivers",
        "external/wpa_supplicant_8/src/l2_packet",
        "external/wpa_supplicant_8/src/utils",
        "external/wpa_supplicant_8/src/wps",
        "external/wpa_supplicant_8/wpa_supplicant",
    ],
    shared_libs: ["libdl", "liblog", "libnl"],
    sanitize: {
        cfi: true,
    },
}
